rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCompanyUser(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid));
    }

    function userRole(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data.role;
    }

    function isCompanyOwner(companyId) {
      return signedIn()
        && get(/databases/$(database)/documents/companies/$(companyId)).data.owner_user_id == request.auth.uid;
    }

    function hasRole(companyId, roles) {
      return (isCompanyUser(companyId) && userRole(companyId) in roles)
        || (isCompanyOwner(companyId) && 'owner' in roles);
    }

    function isOwnerOrAdmin(companyId) {
      return hasRole(companyId, ['owner', 'admin']);
    }

    function isAdmin(companyId) {
      return isCompanyUser(companyId) && userRole(companyId) == 'admin';
    }

    function canManageInventory(companyId) {
      return hasRole(companyId, ['owner', 'admin', 'manager']);
    }

    function canSell(companyId) {
      return hasRole(companyId, ['owner', 'admin', 'manager', 'cashier']);
    }

    match /companies/{companyId} {
      allow create: if signedIn()
        && request.resource.data.id == companyId
        && request.resource.data.owner_user_id == request.auth.uid;
      allow read: if isCompanyUser(companyId) || isCompanyOwner(companyId);
      allow update: if isOwnerOrAdmin(companyId);
      allow delete: if false;

      match /users/{userId} {
        allow read: if isCompanyUser(companyId);
        allow create: if signedIn()
          && (
            (userId == request.auth.uid
              && request.resource.data.company_id == companyId
              && request.resource.data.role == 'owner'
              && get(/databases/$(database)/documents/companies/$(companyId)).data.owner_user_id == request.auth.uid)
            || (isCompanyOwner(companyId)
              && request.resource.data.company_id == companyId
              && request.resource.data.role in ['admin', 'manager', 'cashier'])
            || (isAdmin(companyId)
              && request.resource.data.company_id == companyId
              && request.resource.data.role in ['manager', 'cashier'])
          );
        allow update: if signedIn()
          && request.resource.data.company_id == companyId
          && (
            (userId == request.auth.uid
              && resource.data.role == 'owner'
              && request.resource.data.role == 'owner'
              && isCompanyOwner(companyId))
            || (isCompanyOwner(companyId)
              && resource.data.role != 'owner'
              && request.resource.data.role in ['admin', 'manager', 'cashier'])
            || (isAdmin(companyId)
              && resource.data.role in ['manager', 'cashier']
              && request.resource.data.role in ['manager', 'cashier'])
          );
        allow delete: if hasRole(companyId, ['owner']);
      }

      match /stores/{storeId} {
        allow read: if isCompanyUser(companyId);
        allow create, update: if isOwnerOrAdmin(companyId);
        allow delete: if hasRole(companyId, ['owner']);
      }

      match /registers/{registerId} {
        allow read: if isCompanyUser(companyId);
        allow create, update: if isOwnerOrAdmin(companyId);
        allow delete: if hasRole(companyId, ['owner']);
      }

      match /products/{productId} {
        allow read: if isCompanyUser(companyId);
        allow create, update, delete: if canManageInventory(companyId);
      }

      match /customers/{customerId} {
        allow read: if isCompanyUser(companyId);
        allow create, update: if canSell(companyId);
        allow delete: if canManageInventory(companyId);
      }

      match /sales/{saleId} {
        allow read: if isCompanyUser(companyId);
        allow create: if canSell(companyId);
        allow update, delete: if isOwnerOrAdmin(companyId);
      }

      match /sale_items/{itemId} {
        allow read: if isCompanyUser(companyId);
        allow create: if canSell(companyId);
        allow update, delete: if isOwnerOrAdmin(companyId);
      }

      match /inventory_movements/{movementId} {
        allow read: if isCompanyUser(companyId);
        allow create: if canSell(companyId);
        allow update, delete: if isOwnerOrAdmin(companyId);
      }
    }

    match /{path=**}/users/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
    }

    match /user_memberships/{userId}/companies/{companyId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow create: if signedIn()
        && (
          (userId == request.auth.uid
            && get(/databases/$(database)/documents/companies/$(companyId)).data.owner_user_id == request.auth.uid
            && request.resource.data.role == 'owner')
          || (isCompanyOwner(companyId) && request.resource.data.role in ['admin', 'manager', 'cashier'])
          || (isAdmin(companyId) && request.resource.data.role in ['manager', 'cashier'])
        );
      allow update: if signedIn()
        && request.resource.data.company_id == companyId
        && (
          (userId == request.auth.uid
            && resource.data.role == 'owner'
            && request.resource.data.role == 'owner'
            && isCompanyOwner(companyId))
          || (isCompanyOwner(companyId)
            && resource.data.role != 'owner'
            && request.resource.data.role in ['admin', 'manager', 'cashier'])
          || (isAdmin(companyId)
            && resource.data.role in ['manager', 'cashier']
            && request.resource.data.role in ['manager', 'cashier'])
        );
      allow delete: if signedIn() && isOwnerOrAdmin(companyId);
    }
  }
}
